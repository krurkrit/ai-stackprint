<Project>
  <!-- Central package versions: projects list packages without versions. Exact versions keep builds repeatable; update here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="FluentAvaloniaUI" Version="3.1.0" />   <!-- Fluent 2 control styles (MIT) layered over the built-in Fluent theme -->
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />   <!-- code coverage: build/coverage.ps1 -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />   <!-- 3.x: the version Avalonia.Headless.XUnit 12.1 is built against -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.6" />   <!-- UI tests without a window; same version as Avalonia -->
  </ItemGroup>
  <ItemGroup>
    <!-- Sonar's C# rules (default "Sonar way" set) in every project at build time; never shipped in the app (Sonar Source-Available License v1.0) -->
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.36.0.15337" />
    <!-- Version of every project from the latest v* git tag (Apache-2.0, build-only) -->
    <GlobalPackageReference Include="MinVer" Version="8.0.0" />
  </ItemGroup>
</Project>
