<Project>
  <!-- Settings shared by every project in the solution -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>   <!-- .NET 10 LTS (supported to Nov 2028); Avalonia 12 recommends it -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Version: from the git tag v<major>.<minor>.<patch> by MinVer (Directory.Packages.props); commits after a tag build as <next patch>-alpha.0.<commits>. Never written here. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>
  <PropertyGroup>
    <!-- .NET analyzers: latest rule set; which rules are warnings is set in .editorconfig (aspnetcore's list) -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>   <!-- IDE rules marked warning in .editorconfig show on build -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>   <!-- needed for IDE0005 (unused usings) on build -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>   <!-- not every public member or parameter needs an XML doc comment -->
  </PropertyGroup>
</Project>
