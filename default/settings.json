// Every setting and its default (built into the app). ~/.ai-stackprint/settings.json holds only the ones you change;
// a missing key there means the value here, so a default changed in a later version reaches everyone who kept it.
{
  "version": 1,

  // Apps
  "hiddenApps": [],                  // app ids not scanned or shown
  "hideNotInstalled": false,         // hide apps that are not found on this machine

  // Appearance
  "theme": "System",                 // System | Light | Dark
  // Fonts: family, size and weight per setting. A setting may have a parent (none = no "parent"). A field with no "mode" is its own value ("set") without a parent
  // and the parent's value ("link") with one; "adjust" is the parent's plus "value" (size and weight). Limits (min/max/step or options) are the app's (FontRoles);
  // a setting may override them with "limit".
  "fonts": {
    "body":     { "family": { "value": "Inter" }, "size": { "value": 14 }, "weight": { "value": 400 } },   // Inter falls back to Noto Sans, then the platform font
    "emphasis": { "parent": "body",     "weight": { "mode": "adjust", "value": 200 } },                    // names and labels: 600 (semibold, as Fluent UI 2)
    "heading":  { "parent": "emphasis", "weight": { "mode": "adjust", "value": 100 } },                    // titles: one step above emphasis (700)
    "menu":     { "parent": "body",     "weight": { "mode": "adjust", "value": 100 } },                    // side menu items: 500
    "log":      { "family": { "value": "JetBrains Mono" }, "size": { "value": 14 }, "weight": { "value": 400 } }   // logs and the config editor
  },
  "logLineNumbers": false,           // logs only; the config editor always shows them
  "fadeSeconds": 10,                 // new log lines stay highlighted this long; 0 = off
  "virtualListRows": 40,             // a list with more rows than this builds only the rows on screen (less memory and time); 0 = every list does
  "light": {},                       // color overrides (accent, hover, selection, levels) as hex; empty: Snowy Owl
  "dark": {},

  // Network (each is off until you turn it on)
  "limitsEnabled": [],               // app ids whose saved sign-in may be used to ask for live limits
  "limitsRefreshMinutes": 1,         // at most one call per app per this many minutes (at least 1)
  "checkUpdates": false,             // ask GitHub for the latest release and the model data at most once a day
  "benchmarksEnabled": false         // download benchmark scores from artificialanalysis.ai with your API key (kept in state.json) at most once a day
}
