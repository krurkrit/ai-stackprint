    {
      "id": "claude-code", "context": "claude", "limits": "claude", "name": "Claude Code", "category": "agent", "logo": "claudecode",
      "detect": ["~/.claude"],
      "roots": [
        {"path": "~/.claude/skills", "level": "User"},
        {"path": "%ProgramData%/ClaudeCode/.claude/skills", "level": "System", "os": "windows", "label": "Managed"},
        {"path": "%ProgramData%/ClaudeCode/skills", "level": "System", "os": "windows", "label": "Managed"},
        {"path": "/Library/Application Support/ClaudeCode/skills", "level": "System", "os": "macos", "label": "Managed"},
        {"path": "/etc/claude-code/skills", "level": "System", "os": "linux", "label": "Managed"}
      ],
      "projectRoots": [
        {"path": ".claude/skills", "level": "Project", "nested": true}
      ],
      "configs": [
        {"path": "~/.claude/CLAUDE.md", "level": "User", "kind": "instructions"},
        {"path": "CLAUDE.md", "level": "Project", "kind": "instructions", "nested": true},
        {"path": ".claude/CLAUDE.md", "level": "Project", "kind": "instructions"},
        {"path": "CLAUDE.local.md", "level": "Local", "kind": "instructions"},
        {"path": "C:/Program Files/ClaudeCode/CLAUDE.md", "level": "System", "kind": "instructions", "os": "windows", "label": "Managed"},
        {"path": "/Library/Application Support/ClaudeCode/CLAUDE.md", "level": "System", "kind": "instructions", "os": "macos", "label": "Managed"},
        {"path": "/etc/claude-code/CLAUDE.md", "level": "System", "kind": "instructions", "os": "linux", "label": "Managed"},
        {"path": "~/.claude/settings.json", "level": "User", "kind": "settings"},
        {"path": ".claude/settings.json", "level": "Project", "kind": "settings"},
        {"path": ".claude/settings.local.json", "level": "Local", "kind": "settings"},
        {"path": "C:/Program Files/ClaudeCode/managed-settings.json", "level": "System", "kind": "settings", "os": "windows", "label": "Managed"},
        {"path": "/Library/Application Support/ClaudeCode/managed-settings.json", "level": "System", "kind": "settings", "os": "macos", "label": "Managed"},
        {"path": "/etc/claude-code/managed-settings.json", "level": "System", "kind": "settings", "os": "linux", "label": "Managed"},
        {"path": ".mcp.json", "level": "Project", "kind": "mcp"},
