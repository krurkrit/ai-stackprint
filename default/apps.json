      "parts": [
        {"path": "~/.claude/commands", "kind": "command"},
        {"path": "~/.claude/agents", "kind": "agent"},
        {"path": ".claude/commands", "level": "Project", "kind": "command"},
        {"path": ".claude/agents", "level": "Project", "kind": "agent"}
      ],
      "pluginFormat": "claude",
      "pluginManifest": "~/.claude/plugins/installed_plugins.json",
      "pluginCommands": {"install": ["claude", "plugin", "install", "{plugin}", "--scope", "{scope}"], "remove": ["claude", "plugin", "uninstall", "{plugin}", "--scope", "{scope}"]},
      "logs": [
        {"path": "~/.claude/debug", "label": "Debug", "pattern": "*.txt"},
        {"path": "~/.claude/projects", "label": "Sessions", "pattern": "*.jsonl", "depth": 3, "format": "claude-session"}
      ]
    },
