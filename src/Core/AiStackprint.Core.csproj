<Project Sdk="Microsoft.NET.Sdk">
  <!-- Models and services: scanning, parsing, checks and file changes. No UI: Avalonia is not referenced here, so services cannot depend on it. -->
  <PropertyGroup>
    <RootNamespace>AiStackprint</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AiStackprint.Core.Tests" />
    <InternalsVisibleTo Include="AiStackprint.App.Tests" />   <!-- UI tests edit model data in a temp file -->
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />   <!-- OpenCode keeps usage in SQLite -->
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\default\apps.json" LogicalName="default/apps.json" Link="default\apps.json" />   <!-- the apps AI Stackprint knows -->
    <EmbeddedResource Include="..\..\default\models.json" LogicalName="default/models.json" Link="default\models.json" />   <!-- model sizes and prices (weekly from LiteLLM) -->
    <EmbeddedResource Include="..\..\default\credits.json" LogicalName="default/credits.json" Link="default\credits.json" />   <!-- free and open-source projects used (Settings › Credits) -->
    <EmbeddedResource Include="..\..\default\settings.json" LogicalName="default/settings.json" Link="default\settings.json" />   <!-- every setting and its default -->
  </ItemGroup>
</Project>
