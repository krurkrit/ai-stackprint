<Project Sdk="Microsoft.NET.Sdk">
  <!-- The desktop app: UI (Avalonia), icons and logos. Scanning and parsing live in Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AiStackprint</AssemblyName>   <!-- exe name stays AiStackprint -->
    <RootNamespace>AiStackprint</RootNamespace>
    <AssemblyTitle>AI Stackprint</AssemblyTitle>   <!-- name Task Manager shows -->
    <Product>AI Stackprint</Product>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>   <!-- exe and taskbar icon -->
    <!-- Lower memory and faster start: no background GC thread, trim idle heap (no ICU: Directory.Build.props) -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AiStackprint.App.Tests" />   <!-- tests check Theme colors -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\AiStackprint.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\app-icon.ico" LogicalName="app-icon.ico" />   <!-- window/taskbar icon: every size, so Windows picks a sharp one instead of shrinking 256 px -->
    <EmbeddedResource Include="Assets\icons.json" LogicalName="icons.json" />
    <EmbeddedResource Include="Assets\logos.json" LogicalName="logos.json" />
  </ItemGroup>
</Project>
