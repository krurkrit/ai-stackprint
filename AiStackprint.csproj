<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AiStackprint</AssemblyName>
    <RootNamespace>AiStackprint</RootNamespace>
    <AssemblyTitle>AI Stackprint</AssemblyTitle>   <!-- name Task Manager shows -->
    <Product>AI Stackprint</Product>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>   <!-- exe and taskbar icon -->
    <!-- Lower memory and faster start: no ICU load, no background GC thread, trim idle heap -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AiStackprint.Tests" />   <!-- tests check Theme colors -->
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.*" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.*" />
    <PackageReference Include="Avalonia.Desktop" Version="12.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.*" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.*" />   <!-- OpenCode keeps usage in SQLite -->
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\app-icon.ico" LogicalName="app-icon.ico" />   <!-- window/taskbar icon: every size, so Windows picks a sharp one instead of shrinking 256 px -->
    <EmbeddedResource Include="Assets\apps.builtin.json" LogicalName="apps.builtin.json" />
    <EmbeddedResource Include="Assets\icons.json" LogicalName="icons.json" />
    <EmbeddedResource Include="Assets\logos.json" LogicalName="logos.json" />
  </ItemGroup>
</Project>
